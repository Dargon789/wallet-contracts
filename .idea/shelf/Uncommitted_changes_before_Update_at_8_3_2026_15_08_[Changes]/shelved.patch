+    })
+  })
+})
+
+describe('setRecipientSync', () => {
+  test('default', async () => {
+    const { token } = await setupToken()
+
+    const connection = getConnection(config)
+
+    // Set reward recipient
+    const { holder, receipt, recipient } = await actions.setRecipientSync(
+      config,
+      {
+        recipient: connection.address!,
+        token,
+      },
