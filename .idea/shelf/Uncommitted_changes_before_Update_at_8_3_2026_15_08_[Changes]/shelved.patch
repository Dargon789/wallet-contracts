+import type { createBaseAccountSDK, ProviderInterface } from '@base-org/account'
+import {
+  ChainNotConfiguredError,
+  type Connector,
+  createConnector,
+} from '@wagmi/core'
+import type { Mutable, Omit } from '@wagmi/core/internal'
