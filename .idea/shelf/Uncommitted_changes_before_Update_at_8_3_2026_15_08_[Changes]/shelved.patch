+    }))
+
+    await result.current.connect.mutateAsync({
+      connector: config.connectors[0]!,
+    })
+
+    const { token } = await setupToken()
+
+    await result.current.setRecipient.mutateAsync({
+      recipient: '0xa5cc3c03994DB5b0d9A5eEdD10CabaB0813678AC',
