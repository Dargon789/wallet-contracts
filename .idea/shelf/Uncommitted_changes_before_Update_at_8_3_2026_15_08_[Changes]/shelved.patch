+
+// Call `mutate` in response to user action (e.g. button click, form submission)
+sellSync.mutate({
+  amountIn: parseUnits('100', 6),
+  minAmountOut: parseUnits('95', 6),
+  tokenIn: '0x20c0000000000000000000000000000000000001',
