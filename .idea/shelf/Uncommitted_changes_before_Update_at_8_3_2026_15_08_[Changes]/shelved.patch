+
+test.each([
+  { blockTag: 'earliest' },
+  { blockTag: 'finalized' },
+  { blockTag: 'latest' },
+  { blockTag: 'pending' },
+  { blockTag: 'safe' },
+] as { blockTag: BlockTag; expected: number }[])(
+  'parameters: blockTag $blockTag',
+  async ({ blockTag }) => {
+    await testClient.mainnet.restart()
+
+    await expect(
+      getTransactionCount(config, {
+        address,
+        blockTag,
+      }),
+    ).resolves.toBeTypeOf('number')
+  },
