+        assertEq(bound(uint256(1), 50, 150), 51);
+        assertEq(bound(uint256(2), 50, 150), 52);
+        assertEq(bound(uint256(3), 50, 150), 53);
+        assertEq(bound(type(uint256).max, 50, 150), 150);
+        assertEq(bound(type(uint256).max - 1, 50, 150), 149);
