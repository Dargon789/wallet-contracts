+
+  const result = await simulateErc20(config, {
+    functionName: 'transferFrom',
+    args: ['0x', '0x', 123n],
+    chainId: optimism.id,
+  })
+  expectTypeOf(result.result).toEqualTypeOf<boolean>()
+
+  simulateErc20(config, {
+    functionName: 'transferFrom',
+    args: ['0x', '0x', 123n],
+    // @ts-expect-error chain id must match address keys
+    chainId: 420,
