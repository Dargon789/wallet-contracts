+import { normalize } from 'viem/ens'
+
+function App() {
+  const result = useEnsText({
+    blockTag: 'latest', // [!code focus]
+    name: normalize('wevm.eth'),
+    key: 'com.twitter',
+  })
+}
+```
+<<< @/snippets/react/config.ts[config.ts]
+:::
