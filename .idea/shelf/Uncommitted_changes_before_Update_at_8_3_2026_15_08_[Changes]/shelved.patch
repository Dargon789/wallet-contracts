+  const { mutation } = parameters
+  const config = useConfig(parameters)
+  return useMutation({
+    ...mutation,
+    async mutationFn(variables) {
+      return Actions.dex.withdrawSync(config, variables as never)
+    },
+    mutationKey: ['withdrawSync'],
+  }) as never
