+  workflow_dispatch:
+
+jobs:
+  snapshot:
+    name: Release snapshot version
+    permissions:
+      contents: write
+      id-token: write
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+
+    steps:
+      - name: Clone repository
+        uses: actions/checkout@v4
+
+      - name: Install dependencies
+        uses: wevm/actions/.github/actions/pnpm@main
+
