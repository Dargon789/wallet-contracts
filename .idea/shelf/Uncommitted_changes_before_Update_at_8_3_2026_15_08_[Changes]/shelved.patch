+        bytes32 initcodeHash = hashInitCode(hex"6080", "");
+        assertEq(initcodeHash, 0x1a578b7a4b0b5755db6d121b4118d4bc68fe170dca840c59bc922f14175a76b0);
+        address create2Address = computeCreate2Address(salt, initcodeHash);
