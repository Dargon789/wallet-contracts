+import { type SendTransactionParameters } from '@wagmi/core'
+```
+
+### accessList
+
+`AccessList | undefined`
+
+The access list.
+
+::: code-group
+```ts [index.ts]
+import { sendTransaction } from '@wagmi/core'
+import { parseEther } from 'viem'
+import { config } from './config'
+
