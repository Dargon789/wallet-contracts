+
+::: code-group
+
+```tsx [index.tsx]
+import { useWriteContract } from 'wagmi'
+import { config } from './config' // [!code focus]
+
+function App() {
+  const writeContract = useWriteContract({
+    config, // [!code focus]
+  })
+}
+```
+
+<<< @/snippets/react/config.ts[config.ts]
