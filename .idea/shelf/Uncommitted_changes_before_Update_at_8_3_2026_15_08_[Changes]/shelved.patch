+
+`WalletCapabilities | undefined`
+
+Capability metadata for the calls (e.g. specifying a paymaster).
+
+::: code-group
+```ts [index.ts]
+import { parseEther } from 'viem'
+import { sendCalls } from '@wagmi/core'
+import { config } from './config'
+
