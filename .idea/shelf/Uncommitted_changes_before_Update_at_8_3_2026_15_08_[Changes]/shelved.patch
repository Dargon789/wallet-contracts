+    'Mail'
+  >
+  expectTypeOf<Pick<Result, 'message' | 'primaryType'>>().toEqualTypeOf<{
+    primaryType?: 'Mail' | 'Person'
+    message?: {
+      from: {
+        name: string
+        wallet: Address
+      }
+      to: {
+        name: string
+        wallet: Address
+      }
+      contents: string
+    }
+  }>()
+})
