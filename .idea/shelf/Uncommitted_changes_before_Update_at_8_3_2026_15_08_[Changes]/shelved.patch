+import { abi } from './abi'
+
+function App() {
+  const result = useInfiniteReadContracts({
+    cacheKey: 'mlootAttributes', // [!code hl]
+    contracts(pageParam) {
+      // ...
+    }
+    query: {
+      initialPageParam: 0,
+      getNextPageParam: (_lastPage, _allPages, lastPageParam) => {
+        return lastPageParam + 1
+      }
+    }
+  })
+}
+```
