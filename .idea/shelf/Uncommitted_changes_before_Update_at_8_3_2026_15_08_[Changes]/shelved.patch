+
+::: code-group
+```tsx [index.tsx]
+import { useWaitForCallsStatus } from 'wagmi'
+import { config } from './config' // [!code focus]
+
+function App() {
+  const result = useWaitForCallsStatus({
+    config, // [!code focus]
+    id: '0x...',
+  })
+}
+```
+<<< @/snippets/react/config.ts[config.ts]
+:::
+
