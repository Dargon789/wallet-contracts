+        connector: Connector
+      }[]
+    | undefined
+  >()
+  expectTypeOf(error.value).toEqualTypeOf<ReconnectErrorType | null>()
+  expectTypeOf(variables.value).toEqualTypeOf<
+    | {
+        connectors?: readonly (CreateConnectorFn | Connector)[] | undefined
+      }
+    | undefined
