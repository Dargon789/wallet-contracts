+## Usage
+
+::: code-group
+```tsx [index.tsx]
+import { useWatchPendingTransactions } from 'wagmi'
+
+function App() {
+  useWatchPendingTransactions({
+    onTransactions(transactions) {
+      console.log('New transactions!', transactions)
