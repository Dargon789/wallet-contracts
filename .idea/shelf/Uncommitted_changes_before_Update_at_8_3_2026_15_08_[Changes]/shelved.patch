+})
+
+describe('useSetUserToken', () => {
+  test('default', async () => {
+    const { result } = await renderHook(() => ({
+      connect: useConnect(),
+      setUserToken: useSetUserToken(),
+    }))
+
+    await result.current.connect.connectAsync({
+      connector: config.connectors[0]!,
