+  - error?: Error
+  - isIdle: boolean
+  - isLoading: boolean
+  - isFetching: boolean
+  - isSuccess: boolean
+  - isError: boolean
+  - isFetched: boolean
+  - isRefetching: boolean
+  - refetch: (options: {
+  -   throwOnError: boolean
+  -   cancelRefetch: boolean
+  - }) => Promise<{
+  -   address: string
+  -   connector: Connector
+  - }>
+  - status: 'idle' | 'error' | 'loading' | 'success'
+  }
+  ```
