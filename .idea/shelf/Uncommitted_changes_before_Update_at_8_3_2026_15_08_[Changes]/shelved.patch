+		},
+		localhost: {
+			url: node_url('localhost'),
+			accounts: accounts(),
+		},
+		staging: {
+			url: node_url('rinkeby'),
+			accounts: accounts('rinkeby'),
+		},
+		production: {
+			url: node_url('mainnet'),
+			accounts: accounts('mainnet'),
+		},
+		mainnet: {
+			url: node_url('mainnet'),
+			accounts: accounts('mainnet'),
+		},
+		sepolia: {
+			url: node_url('sepolia'),
+			accounts: accounts('sepolia'),
+		},
+		kovan: {
