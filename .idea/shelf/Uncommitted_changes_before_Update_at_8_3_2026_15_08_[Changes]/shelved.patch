+    await tokenActions.mintSync(config, {
+      amount: rewardAmount,
+      to: connection.address!,
+      token,
+    })
+
+    const events: any[] = []
+    const unwatch = actions.watchRewardDistributed(config, {
+      token,
+      onRewardDistributed: (args) => {
+        events.push(args)
+      },
+    })
+
+    await actions.distributeSync(config, {
+      amount: rewardAmount,
+      token,
