+// @filename: example.ts
+// ---cut---
+import { Actions } from 'wagmi/tempo'
+import { config } from './config'
+
+const { receipt, value } = await Actions.token.revokeRolesSync(config, {
+  from: '0x742d35Cc6634C0532925a3b844Bc9e7595f0bEbb',
