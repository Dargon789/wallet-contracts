+pragma solidity 0.8.17;
+
+import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import "./ERC20Base.sol";
+import "./WithPermitAndFixedDomain.sol";
+
+contract SimpleERC20 is ERC20Base, WithPermitAndFixedDomain {
