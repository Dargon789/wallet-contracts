+
+test('select data', () => {
+  const result = useVerifyTypedData({
+    query: {
+      select(data) {
+        return data
+      },
+    },
+  })
+  expectTypeOf(result.data).toEqualTypeOf<boolean | undefined>()
+})
+
+test('UseReadContractParameters', () => {
+  type Result = UseVerifyTypedDataParameters<
