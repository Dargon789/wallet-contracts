+```
+
+### chains <Badge type="warning">[deprecated](/react/guides/migrate-from-v2-to-v3#removed-useswitchchain-chains)</Badge>
+
+`readonly [Chain, ...Chain[]]`
+
+Globally configured chains. Useful for rendering a list of available chains to switch to.
+
+::: code-group
+```tsx [index.tsx]
+import { useSwitchChain } from 'wagmi'
+
+function App() {
+  const switchChain = useSwitchChain()
+  return (
+    <div>
+      {switchChain.chains.map((chain) => (
+        <button key={chain.id} onClick={() => switchChain({ chainId: chain.id })}>
+          {chain.name}
+        </button>
+      ))}
+    </div>
+  )
+}
+```
+<<< @/snippets/react/config.ts[config.ts]
+:::
