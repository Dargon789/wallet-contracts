+ *
+ *   return (
+ *     <button
+ *       onClick={() => mutate({
+ *         amount: 100n,
+ *         token: '0x20c...11',
+ *       })}
+ *       disabled={isPending}
+ *     >
+ *       Withdraw
+ *     </button>
+ *   )
+ * }
